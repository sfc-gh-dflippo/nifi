<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.nifi</groupId>
        <artifactId>nifi-standard-shared-bom</artifactId>
        <version>2.6.0</version>
        <relativePath>../nifi-standard-shared-bundle/nifi-standard-shared-bom</relativePath>
    </parent>
    <artifactId>nifi-postgresql-bundle</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>nifi-postgresql-processors-nar</module>
        <module>nifi-postgresql-processors</module>
        <module>nifi-postgresql-services-api-nar</module>
        <module>nifi-postgresql-services-api</module>
        <module>nifi-postgresql-services-nar</module>
        <module>nifi-postgresql-services</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal bundle modules - version inherited from parent -->
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-postgresql-services-api</artifactId>
                <version>2.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-postgresql-services-api-nar</artifactId>
                <version>2.6.0</version>
                <type>nar</type>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-postgresql-services</artifactId>
                <version>2.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-postgresql-processors</artifactId>
                <version>2.6.0</version>
            </dependency>
            
            <!-- NiFi framework dependencies used across modules -->
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-standard-shared-nar</artifactId>
                <version>2.6.0</version>
                <type>nar</type>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-dbcp-base</artifactId>
                <version>2.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-standard-processors</artifactId>
                <version>2.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-standard-record-utils</artifactId>
                <version>2.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-parquet-processors</artifactId>
                <version>2.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-record-serialization-services</artifactId>
                <version>2.6.0</version>
            </dependency>
            
            <!-- External dependencies used across multiple modules -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.7</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>1.20.5</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>1.20.5</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <!-- Include only unit tests by default -->
                            <include>**/*Test.java</include>
                        </includes>
                        <excludes>
                            <!-- Exclude integration tests from default execution -->
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <!-- Include only integration tests -->
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Profile to run integration tests requiring database connectivity -->
        <profile>
            <id>connectivity-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile to skip integration tests -->
        <profile>
            <id>skip-postgresql-tests</id>
            <properties>
                <skipTests>true</skipTests>
            </properties>
        </profile>
    </profiles>
</project>
